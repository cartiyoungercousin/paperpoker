# Copy this file to .env for local overrides, or set these as real
# environment variables/secrets on your hosting provider. Nothing in this
# file is a real secret - it's just documenting what server.js reads.

# Port the HTTP/socket.io server listens on. Most hosting providers set this
# for you automatically - only set it yourself for local runs on a specific port.
PORT=3000

# Set to "production" once actually deployed - this is what turns on the
# Secure flag on auth/session cookies (see server.js's IS_PRODUCTION check).
# Leave unset (or anything other than "production") for local development,
# since a plain http://localhost dev server would never receive a Secure
# cookie back from the browser at all.
NODE_ENV=production

# Where the sqlite database file lives. In production this MUST point at a
# persistent volume/disk your host provides - the default (./data/paperpoker.sqlite,
# relative to the app) lives on the container's local filesystem, which most
# managed hosts wipe on every redeploy/restart. Point this at your mounted
# volume instead, e.g. /data/paperpoker.sqlite on Fly.io.
PAPERPOKER_DB_PATH=./data/paperpoker.sqlite
